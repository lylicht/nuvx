{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vyral",
  "account_id": "a320f379358ed6b713c82a8071557b4a",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PartyRoom" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom", "Registry"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
